# OpenRouter key from https://openrouter.ai/keys - the only value you must set.
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Free model. Availability rotates, so re-check when classification starts failing.
TICKETAG_MODEL=nex-agi/nex-n2.5-mini:free

# Tried in order when the primary is unavailable. OpenRouter routes at most 3
# models total, so 2 fallbacks, spread across vendors: a saturated free pool is
# shared by every free user of that vendor.
TICKETAG_FALLBACK_MODELS=google/gemma-4-31b-it:free,z-ai/glm-5.2:free

# Free tier allows 20 requests/minute account-wide. Raise only on a paid model.
TICKETAG_REQUESTS_PER_MINUTE=20

TICKETAG_BASE_URL=https://openrouter.ai/api/v1
TICKETAG_TIMEOUT=60
TICKETAG_MAX_RETRIES=3

# Covers the answer plus any hidden reasoning tokens. Too low on a reasoning
# model truncates the JSON answer away and the ticket fails.
TICKETAG_MAX_TOKENS=900

# --- RAG backend (ticketag-rag / ticketag-rag-ingest) ---
# Chroma Cloud free-tier credentials from https://trychroma.com — run
# `chroma login && chroma db create <name> && chroma db connect <name> --env-file`
# to generate these three values automatically.
CHROMA_API_KEY=ck-your_key_here
CHROMA_TENANT=your-tenant-id
CHROMA_DATABASE=your-database-name

# Collection to read/write tickets in.
TICKETAG_RAG_COLLECTION=ticketag_tickets

# Nearest neighbors retrieved per ticket for the majority vote.
TICKETAG_RAG_K=5

# Minimum vote-share confidence before a prediction is written back into the
# knowledge base automatically. Below this, ingest the confirmed label by hand.
TICKETAG_RAG_AUTO_ADD_THRESHOLD=0.8

